# Copia este archivo como .env.local. Nunca escribas secretos en variables VITE_*.
VITE_SUPABASE_URL=https://ycomlinemyhlwjaklxju.supabase.co
# Sustituye el marcador con la clave PUBLICABLE real del panel (no es un secreto).
VITE_SUPABASE_PUBLISHABLE_KEY=COPIA_AQUI_TU_CLAVE_PUBLICABLE
# Alternativa: deja la publicable vacía y configura la clave heredada anon.
# VITE_SUPABASE_ANON_KEY=
# Local: /. En Pages, el workflow usa /project_album/.
VITE_BASE_PATH=/
# OPCIONAL. Sitekey PÚBLICA de Cloudflare Turnstile (empieza por 0x4AAAA y tiene ~24 caracteres).
# Vacía = CAPTCHA desactivado en el formulario. La clave SECRETA de Turnstile va SOLO en el panel
# de Supabase (Authentication → Attack Protection / Bot and Abuse Protection), nunca aquí.
# Pasos completos en docs/MEJORAS.md.
VITE_TURNSTILE_SITE_KEY=
